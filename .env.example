# Which backend serves products and receives orders: "sheet" or "laravel".
# Defaults to "sheet" when unset.
VITE_ORDER_BACKEND=sheet

# --- VITE_ORDER_BACKEND=sheet ---------------------------------------------
# Published Google Sheet CSV (File > Share > Publish to web > that sheet > CSV).
# Leave blank to always use the bundled fallback product list.
VITE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vSEtbg-fj5416tvkz3_QUl0KlEw7wyyQylsw-ZYNAaXoYAgiju786ovNjU2cww8q5u4GLRt6SyFhPaz/pub?gid=848857453&single=true&output=csv

# --- VITE_ORDER_BACKEND=laravel -------------------------------------------
# Origin of the Laravel API, no trailing slash. It must allow this site's
# origin via CORS and accept multipart/form-data on POST /api/orders.
VITE_API_URL=http://localhost:8000
