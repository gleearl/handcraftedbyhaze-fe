# Origin of the Laravel API when running `npm run dev`.
#
# Fixed here rather than left to whoever is running it: this SPA on :5173 and
# the API on :8000 are different origins, so a blank value would send every
# request to the dev server itself, which serves no /api and answers 404.
#
# `php artisan serve` defaults to this port, and Laravel's FRONTEND_URL and
# CORS config already name :5173, so the pair lines up with no further setup.
VITE_API_URL=http://localhost:8000
